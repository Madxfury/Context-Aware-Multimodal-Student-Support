# Copy to .env and fill in your own values. Never commit .env.

# ── AI providers ─────────────────────────────────────────────
GROQ_API_KEY=            # chat replies and counsellor summary (required for generated replies)
ELEVENLABS_API_KEY=      # optional: English voice (free plan: 10,000 characters/month)
SARVAM_API_KEY=          # optional: speech-to-text for voice notes

# ── Server ───────────────────────────────────────────────────
PORT=5002
FLASK_DEBUG=0
# SECRET_KEY=                       # optional Flask secret
# SAMVYA_ALLOWED_HOSTS=myhost.local # extra host names (history/report routes have no login)

# ── Optional model locations (weights are not in the repository) ──
# EMOTION_MODEL_PATH=/absolute/path/to/Swin_FANE_Best_Model.pth
# EXPRESSION_MODEL_PATH=/absolute/path/to/enet_b2_7.onnx
# PHYSIOLOGICAL_MODEL_PATH=/absolute/path/to/best_bilstm.pth
# PIPER_VOICE_DIR=/absolute/path/to/piper/voices
# DATABASE_PATH=/absolute/path/to/counsellor.db

# ── Voice order ──────────────────────────────────────────────
# SAMVYA_TTS_ORDER=edge,piper       # e.g. offline only: piper

# ── USB wearable (Seeed XIAO ESP32-S3) ───────────────────────
# SAMVYA_WEARABLE_PORT=/dev/cu.usbmodem101   # or "off" to disable the reader
# SAMVYA_ACCEL_OFFSET=0,0,-1.19              # zero-g offset of this board's MPU6050
